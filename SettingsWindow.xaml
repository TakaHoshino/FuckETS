<Window x:Class="FuckETS.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">

        <TextBlock Text="更新" FontWeight="Bold" Margin="0,0,0,8"/>

        <CheckBox x:Name="CheckOnStartupCheck" Content="启动时检查更新" Margin="0,0,0,10"/>

        <TextBlock Text="更新下载源：" Margin="0,0,0,4"/>
        <RadioButton x:Name="OfficialSourceRadio" Content="官方源（github.com 直连）" GroupName="UpdateSource" Margin="0,2,0,0"/>
        <RadioButton x:Name="ProxySourceRadio" Content="gh-proxy 代理源（国内加速）" GroupName="UpdateSource" Margin="0,2,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="CheckNowButton" Content="立即检查" Padding="10,4" Click="CheckNowButton_Click"/>
            <TextBlock x:Name="CheckStatusText" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="Gray" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="检查更新基于 GitHub Releases；设置持久化到 %APPDATA%\FuckETS\update.json。"
                   FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:Name="OkButton" Content="确定" Width="80" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

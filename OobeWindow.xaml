<Window x:Class="FuckETS.OobeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FuckETS - 初始设置向导" Height="560" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题与阶段指示 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="欢迎使用 FuckETS" FontSize="20" FontWeight="Bold"
                       Foreground="#2C3E50" TextWrapping="Wrap"/>
            <TextBlock x:Name="StepText" Text="步骤 1 / 4" FontSize="12" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="4" Value="1" Height="6" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- 页面宿主 -->
        <Frame x:Name="ContentFrame" Grid.Row="1"/>

        <!-- 底部导航 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevButton" Grid.Column="1" Content="上一步" Width="90" Margin="0,0,8,0"
                    Padding="8,4" Click="PrevButton_Click" Visibility="Collapsed"/>
            <Button x:Name="NextButton" Grid.Column="2" Content="下一步" Width="90"
                    Padding="8,4" Click="NextButton_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
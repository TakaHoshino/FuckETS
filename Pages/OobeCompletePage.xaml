<pages:OobePageBase x:Class="FuckETS.Pages.OobeCompletePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:FuckETS.Pages">
    <StackPanel Margin="4" VerticalAlignment="Center">
        <TextBlock Text="设置完成" FontSize="18" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
        <TextBlock Text="即将进入主界面" FontSize="13" Foreground="#555555" TextWrapping="Wrap"
                   HorizontalAlignment="Center" Margin="0,6,0,18"/>

        <Border Background="#F4F6F8" CornerRadius="6" Padding="14" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="配置摘要" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <TextBlock x:Name="ModeSummary" FontSize="13" TextWrapping="Wrap" Foreground="#333333"/>
                <TextBlock x:Name="DirSummary" FontSize="13" TextWrapping="Wrap" Foreground="#333333" Margin="0,4,0,0"/>
                <TextBlock Text="免责声明：已同意" FontSize="13" Foreground="#333333" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Text="点击“完成”保存配置并进入主界面。" FontSize="12" Foreground="#7F8C8D"
                   TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
</pages:OobePageBase>
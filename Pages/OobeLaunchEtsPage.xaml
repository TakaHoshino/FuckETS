<pages:OobePageBase x:Class="FuckETS.Pages.OobeLaunchEtsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:FuckETS.Pages">
    <StackPanel Margin="4">
        <TextBlock Text="等待并启动 E听说 客户端" FontSize="16" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,12"/>
        <TextBlock x:Name="HintText" Text="请启动电脑上的「讯飞 E听说」客户端。检测到其运行后，将自动推导并记录「讯飞 E听说」的安装目录（而非本软件目录）。"
                   FontSize="13" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel x:Name="WaitingPanel" Orientation="Horizontal" Margin="0,0,0,12">
            <ProgressBar x:Name="WaitingIndicator" IsIndeterminate="True" Height="6" Width="200" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="等待 E听说 启动…" FontSize="13" Foreground="#2980B9"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <StackPanel x:Name="FoundPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="已检测到 E听说，" FontSize="14" Foreground="#27AE60" VerticalAlignment="Center"/>
            <TextBlock x:Name="FoundDirText" FontSize="14" Foreground="#27AE60" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" Margin="6,0,0,0"/>
        </StackPanel>

        <Button x:Name="RetryButton" Content="重新检测" Width="120" Height="32" HorizontalAlignment="Left"
                Click="RetryButton_Click"/>

        <TextBlock Text="长时间未检测到？可返回上一步改用手动输入。" FontSize="12" Foreground="#7F8C8D"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</pages:OobePageBase>
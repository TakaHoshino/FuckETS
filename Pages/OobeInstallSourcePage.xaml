<pages:OobePageBase x:Class="FuckETS.Pages.OobeInstallSourcePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:FuckETS.Pages">
    <StackPanel Margin="4">
        <TextBlock Text="请选择获取 E听说 安装目录的方式" FontSize="16" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,6"/>
        <TextBlock Text="此处“安装目录”指电脑上安装的「讯飞 E听说」客户端的目录，并非本软件的安装目录。"
                   FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <RadioButton x:Name="AutoRadio" Content="自动获取（推荐）：自动从正在运行的 E听说 推导其安装目录" GroupName="InstallSource"
                     FontSize="14" Margin="0,0,0,8"/>
        <RadioButton x:Name="ManualRadio" Content="手动输入：自行填写 E听说 客户端的安装目录" GroupName="InstallSource"
                     FontSize="14" Margin="0,0,0,4"/>

        <StackPanel x:Name="ManualPanel" Margin="24,8,0,0" Visibility="Collapsed">
            <TextBlock Text="请选择或输入「讯飞 E听说」客户端的安装根目录（即安装 E听说 的文件夹，而非本软件）："
                       FontSize="13" Foreground="#555555"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="浏览…" Height="30" Padding="10,0" Click="BrowseButton_Click"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</pages:OobePageBase>
<pages:OobePageBase x:Class="FuckETS.Pages.OobeDisclaimerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:pages="clr-namespace:FuckETS.Pages">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 免责声明文本（可滚动，避免内容过长把按钮挤出可视区域） -->

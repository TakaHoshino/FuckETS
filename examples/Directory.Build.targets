<Project>

  <!-- 示例插件构建后自动打包 .fep 到项目自身输出目录（bin\<Config>\net8.0\） -->
  <Target Name="PackFepAfterBuild" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\plugin.json')">
    <PropertyGroup>
      <!-- GetDirectoryName 去除 OutputPath 尾部反斜杠，避免命令行 "path\" 转义问题 -->
      <_FepOutDir>$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)\$(OutputPath)'))</_FepOutDir>
      <_PackFepScript>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\scripts\pack_fep.ps1'))</_PackFepScript>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_PackFepScript)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -Configuration $(Configuration) -NoBuild -OutputDir &quot;$(_FepOutDir)&quot;" />
  </Target>

</Project>

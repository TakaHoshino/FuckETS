<Window x:Class="FuckETS.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件管理" Height="460" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="加载 .fep 插件…" Padding="10,4" Margin="0,0,8,0" Click="LoadPluginButton_Click"/>
            <Button x:Name="RemoveButton" Content="移除所选插件" Padding="10,4" Margin="0,0,8,0"
                    IsEnabled="False" Click="RemoveButton_Click"/>
            <TextBlock x:Name="PluginDirLabel" VerticalAlignment="Center" Foreground="#666"/>
        </StackPanel>

        <!-- 插件列表 -->
        <ListView Grid.Row="1" x:Name="PluginList" SelectionMode="Single" SelectionChanged="PluginList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="220" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="标识" Width="240" DisplayMemberBinding="{Binding Manifest.Id}"/>
                    <GridViewColumn Header="作者" Width="80" DisplayMemberBinding="{Binding Manifest.Author}"/>
                    <GridViewColumn Header="来源" Width="90" DisplayMemberBinding="{Binding SourceLabel}"/>
                    <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding StateLabel}"/>
                    <GridViewColumn Header="操作" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="切换启用" Padding="6,2"
                                        Tag="{Binding Manifest.Id}"
                                        Click="ToggleButton_Click"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 底部说明与关闭 -->
        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <Button Content="关闭" Width="90" Padding="10,4" HorizontalAlignment="Right"
                    DockPanel.Dock="Right" Click="CloseButton_Click"/>
            <TextBlock TextWrapping="Wrap" Foreground="#666"
                       Text="内置插件不可移除；解析插件须保持至少一个启用才能使用解析功能。启用/禁用与选择状态会持久化保存。"/>
        </DockPanel>
    </Grid>
</Window>
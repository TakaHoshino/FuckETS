<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>FuckETS</RootNamespace>
    <AssemblyName>FuckETS</AssemblyName>
    <Version>2.0.1</Version>
    <!-- 仅面向 Windows x64，裁剪掉 QuestPDF 带来的 Linux/macOS 等非目标运行时原生库 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- 嵌套的 PluginSdk 类库与示例插件不要被主项目默认通配符包含 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);FuckETS.PluginSdk\**;examples\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <ProjectReference Include="FuckETS.PluginSdk\FuckETS.PluginSdk.csproj" />
  </ItemGroup>

</Project>